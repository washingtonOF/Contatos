rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.admin == true;
    }
    match /users/{uid} {
      allow get: if verifiedAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if verifiedAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if false;
    }
  }
}
