rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{conversationType}/{conversationId}/{sender}/{messageId} {
      function familyAccount() {
        return request.auth != null && request.auth.token.get('email_verified', false) == true;
      }

      function validConversation() {
        return conversationType in ['familyLinks', 'groups'];
      }

      function member() {
        let chat = firestore.get(
          /databases/(default)/documents/$(conversationType)/$(conversationId)
        ).data;
        return request.auth.uid in chat.members && !('revokedAt' in chat);
      }

      function messageExists() {
        return firestore.exists(
          /databases/(default)/documents/$(conversationType)/$(conversationId)/messages/$(messageId)
        );
      }

      function publishedAttachment() {
        let message = firestore.get(
          /databases/(default)/documents/$(conversationType)/$(conversationId)/messages/$(messageId)
        ).data;
        return message.sender == sender && message.fileSize == resource.size;
      }

      allow get: if familyAccount() && validConversation() && member() && publishedAttachment();
      allow create: if familyAccount() && validConversation() && member()
        && sender == request.auth.uid && !messageExists()
        && request.resource.size > 0 && request.resource.size <= 26214400
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if familyAccount() && validConversation() && sender == request.auth.uid
        && !messageExists();
    }

    match /statuses/{linkId}/{sender}/{statusId} {
      function account() {
        return request.auth != null && request.auth.token.get('email_verified', false) == true;
      }

      function member() {
        let link = firestore.get(/databases/(default)/documents/familyLinks/$(linkId)).data;
        return request.auth.uid in link.members && !('revokedAt' in link);
      }

      function statusPath() {
        return /databases/(default)/documents/familyLinks/$(linkId)/statuses/$(statusId);
      }

      function visible() {
        let status = firestore.get(statusPath()).data;
        return status.sender == sender && status.mediaType == resource.contentType
          && status.size == resource.size
          && request.time < status.createdAt + duration.value(24, 'h');
      }

      allow get: if account() && member() && visible();
      allow create: if account() && member() && sender == request.auth.uid
        && !firestore.exists(statusPath())
        && request.resource.size > 0 && request.resource.size <= 26214400
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4'];
      allow delete: if account() && sender == request.auth.uid && !firestore.exists(statusPath());
    }
  }
}
